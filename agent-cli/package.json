{
	"name": "@bigai-nlco/bcg-agent",
	"version": "1.0.0",
	"description": "Interactive Belief Context Graph agent with graph-backed context management",
	"type": "module",
	"bcgConfig": {
		"name": "bcg",
		"configDir": ".bcg"
	},
	"workspaces": [
		"packages/*"
	],
	"bin": {
		"bcg-agent": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc-entry": {
			"import": "./dist/rpc-entry.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build:packages": "npm run build -w @bigai-nlco/bcg-ai && npm run build -w @bigai-nlco/bcg-agent-core && npm run build -w @bigai-nlco/bcg-tui",
		"build": "npm run clean && npm run build:packages && tsc -p tsconfig.build.json && shx chmod +x dist/cli.js dist/rpc-entry.js && npm run copy-assets",
		"copy-assets": "shx mkdir -p dist/modes/interactive/theme && shx cp src/modes/interactive/theme/*.json dist/modes/interactive/theme/ && shx mkdir -p dist/core/export-html/vendor && shx cp src/core/export-html/template.html src/core/export-html/template.css src/core/export-html/template.js dist/core/export-html/ && shx cp src/core/export-html/vendor/*.js dist/core/export-html/vendor/",
		"check": "npm run build",
		"pretest": "npm run build:packages",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@bigai-nlco/bcg-agent-core": "0.1.0",
		"@bigai-nlco/bcg-ai": "0.1.0",
		"@bigai-nlco/bcg-tui": "0.1.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"glob": "13.0.6",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.5",
		"jiti": "2.7.0",
		"minimatch": "^10.2.6",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.0",
		"typebox": "1.1.38",
		"undici": "^8.10.0",
		"yaml": "2.9.0"
	},
	"bundledDependencies": true,
	"overrides": {
		"brace-expansion": "5.0.9",
		"protobufjs": "7.6.5",
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/diff": "7.0.2",
		"@types/hosted-git-info": "3.0.5",
		"@types/ms": "2.1.0",
		"@types/node": "24.12.4",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"keywords": [
		"belief-context-graph",
		"memory",
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "BIGAI NLCO",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bigai-nlco/belief-context-graph.git",
		"directory": "agent-cli"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"bundleDependencies": [
		"@bigai-nlco/bcg-agent-core",
		"@bigai-nlco/bcg-ai",
		"@bigai-nlco/bcg-tui",
		"@silvia-odwyer/photon-node",
		"chalk",
		"cross-spawn",
		"diff",
		"glob",
		"highlight.js",
		"hosted-git-info",
		"ignore",
		"jiti",
		"minimatch",
		"proper-lockfile",
		"semver",
		"typebox",
		"undici",
		"yaml"
	]
}
