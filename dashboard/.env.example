# BCG construct server (contracts/http.schema.json)
VITE_BCG_API_URL=http://127.0.0.1:8848
# Optional explicit problem_id; when empty the dashboard resolves the
# active session via GET /health.
VITE_BCG_PROBLEM_ID=

# Devtool-only Memgraph wiring (not required for the graph dashboard)
VITE_MEMGRAPH_URI=bolt://localhost:7687
VITE_MEMGRAPH_LAB_URL=http://localhost:12345/lab
