# Example config for BCG.

# OpenAI Responses API
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.4"
OPENAI_TIMEOUT="60"
OPENAI_MAX_RETRIES="3"

# Optional. Set this only when using a non-default OpenAI-compatible endpoint.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Langfuse tracing
# Tracing is active only when BCG_TRACING_ENABLED is not false and both keys are set.
BCG_TRACING_ENABLED="true"
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."

# Langfuse host. Other data regions include:
# US: https://us.cloud.langfuse.com
# Japan: https://jp.cloud.langfuse.com
# HIPAA: https://hipaa.cloud.langfuse.com
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
