# Development/automation fallback. Normal global installations use `bcg setup`,
# which stores private credentials in ~/.bcg/.env and runtime choices in
# ~/.bcg/config.json. A project .env is intentionally ignored by Git.

# Primary OpenAI-compatible model API.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_TIMEOUT="60"
OPENAI_MAX_RETRIES="3"

# Optional. Set only when using a non-default OpenAI-compatible endpoint.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional Google search for the terminal Agent.
SERPER_API_KEY="your-serper-api-key"
SERPER_ENDPOINT="https://google.serper.dev/search"
SERPER_COUNTRY="us"
SERPER_LANGUAGE="en"
SERPER_MAX_OUTPUT_CHARS="12000"

# Optional embedding API for semantic split/merge.
# Pipeline behavior is configured by Python arguments, not env vars.
# batch_size and dimensions are EmbeddingConfig fields, not env vars.
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY="sk-..."
EMBEDDING_BASE_URL="https://api.openai.com/v1"

# Authentication token used by the local OpenAI-compatible Qwen services that
# construct.light uses for node extraction and edge generation.
BELIEF_GRAPH_LOCAL_API_KEY="EMPTY"

# Unified Agent and Graph Construction launcher.
BELIEF_GRAPH_URL="http://127.0.0.1:8848"
BCG_GRAPH_BACKEND="light"
BCG_GRAPH_CONFIG="bcg/model_config.json"
BCG_GRAPH_START_TIMEOUT="120"
BCG_GRAPH_TIMEOUT_MS="300000"
BCG_RECENT_TURNS="2"

# Optional local GPU service profiles. These names are deliberately separate
# from MODEL, which is the remote/API model used by Agent rollouts.
VLLM_MODEL=""
VLLM_HOST="0.0.0.0"
VLLM_PORT="8001"
VLLM_MAX_MODEL_LEN="65536"
VLLM_GPU_MEMORY_UTILIZATION="0.88"
VLLM_VISIBLE_GPUS="0"
SGLANG_MODEL=""
SGLANG_HOST="0.0.0.0"
SGLANG_PORT="8003"
SGLANG_VISIBLE_GPUS="1"

# Optional TongGraph server credentials.
TONGGRAPH_ADMIN_TOKEN=""
TONGGRAPH_AGENT_WRITER_TOKEN=""
TONGGRAPH_AGENT_READER_TOKEN=""

# Langfuse tracing.
# Tracing is active only when BCG_TRACING_ENABLED is not false and both keys are set.
BCG_TRACING_ENABLED="true"
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."

# Langfuse host. Other data regions include:
# US: https://us.cloud.langfuse.com
# Japan: https://jp.cloud.langfuse.com
# HIPAA: https://hipaa.cloud.langfuse.com
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
