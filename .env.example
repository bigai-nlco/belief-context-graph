# Required: model used by the built-in react and agent_team profiles.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ReAct and Agent Team use BCG directly. Start the graph server separately; its model/key
# configuration uses the bundled bcg/ package, not this Agent's OPENAI_* values.
# Refer to GRAPH_API_KEY via api_key_env in your bcg.yaml model configuration.
GRAPH_API_KEY=
BCG_GRAPH_URL=http://127.0.0.1:8850
BCG_RECENT_TURNS=2
# Single-Agent BCG: complete evicted steps immediately before the raw tail.
BCG_GRAPH_RECENT_TURNS=3
# Character budget below is for Team / legacy retrieval, not the recent window.
BCG_GRAPH_CHARS=6600
# Agent Team reserves this part of the above total for linked remote beliefs.
BCG_TEAM_CROSS_GRAPH_CHARS=2000
BCG_GRAPH_TIMEOUT=120
# Optional authentication to a protected graph endpoint (NOT a model API key).
BCG_GRAPH_API_KEY=
# Agent Team / offline replay only; single-Agent BCG uses recent_steps.
# Default: query_pcst (Agent-side PCST with remote query relevance).
# Alternatives: confidence_pcst (no embeddings), focused (server selection).
BCG_RETRIEVAL=query_pcst
BCG_PCST_EDGE_COST=0.2
BCG_PCST_CONFIDENCE_FLOOR=0.2
# The Graph construction service has its own independent embedding config.
BCG_RETRIEVAL_EMBEDDING_PROVIDER=openai
BCG_RETRIEVAL_EMBEDDING_URL=http://10.1.100.76:8016/v1/embeddings
BCG_RETRIEVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BCG_RETRIEVAL_EMBEDDING_API_KEY=
BCG_RETRIEVAL_EMBEDDING_TIMEOUT=60
# Conservative UTF-8 byte chunks for the deployed MiniLM 256-token window.
BCG_RETRIEVAL_EMBEDDING_CHUNK_BYTES=240
# Increment when replacing weights behind the same endpoint/model name.
BCG_RETRIEVAL_EMBEDDING_REVISION=1
# Set tonggraph to persist node vectors across Agent restarts.
BCG_RETRIEVAL_EMBEDDING_STORE=memory
TONGGRAPH_BASE_URL=http://127.0.0.1:8719
TONGGRAPH_GRAPH=frontier_retrieval
# Existing writer credential; never use an admin token for retrieval caching.
TONGGRAPH_TOKEN=
TONGGRAPH_TIMEOUT=30
# Only used with provider=local (uv sync --extra bcg-embeddings).
BCG_RETRIEVAL_EMBEDDING_DEVICE=cpu

# Optional: benchmark judge/scorer endpoint. Falls back to OPENAI_* when empty.
# FrontierSearchBench's scorer takes JUDGE_API_KEY + JUDGE_BASE_URL as its
# OPENROUTER_* pair (key and URL always come from the same provider). It pins
# its own model slate, so JUDGE_MODEL does not apply to it.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
# DeepResearch Bench II rubric judge (run_reports judge). Model: JUDGE_MODEL,
# default gpt-6-luna (the upstream evaluator pins gpt-5.5). Reasoning effort
# defaults to high (upstream: medium); it is never lowered on retries.
DRB2_JUDGE_REASONING_EFFORT=

# Optional: benchmark dataset configuration.
# HF_TOKEN is required for gated datasets such as OfficeQA and APEX.
HF_TOKEN=
# OfficeQA corpus format: parsed (default) or raw. Raw mode requires downloading
# the dataset with --raw-pdfs.
OFFICEQA_DOC_MODE=parsed
# Store large benchmark datasets outside the repository when desired.
FRONTIER_AGENT_DATASETS_DIR=

# Optional: web search and page fetching.
# Serper remains the default. Set WEB_SEARCH_PROVIDER=parallel to use the free,
# keyless Parallel Search MCP for web_search (up to 10 results per query);
# this does not change web_fetch.
WEB_SEARCH_PROVIDER=serper
# Support any Serper.dev-compatible endpoint (like litescrape.com, serpbase.dev,
# and others): set SERPER_BASE_URL and a provider-issued SERPER_API_KEY.
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
# Optional report benchmark --fetch-provider serper endpoint override.
# Otherwise uses SERPER_BASE_URL/scrape (or https://scrape.serper.dev for public Serper).
SERPER_SCRAPE_ENDPOINT=
JINA_API_KEY=
JINA_BASE_URL=https://r.jina.ai

# Optional: condense long fetched pages with an OpenAI-compatible endpoint.
# SUMMARY_LLM_BASE_URL must be the full chat-completions URL.
# Leave these empty and page extraction automatically falls back to the
# OPENAI_BASE_URL / OPENAI_MODEL above. Point them at a cheaper/faster model
# to keep whole scraped pages off your primary model's token bill.
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_MODEL_NAME=

# Optional: read images and image-only PDF pages. Recommended for OfficeQA;
# without it, image-based questions may lose points.
# READDOC_VISION_URL is an OpenAI-compatible base URL including /v1.
READDOC_VISION_URL=
READDOC_VISION_MODEL=
READDOC_VISION_KEY=

# Optional: OCR scanned PDFs via POST <url>/ocr.
READDOC_OCR_URL=
READDOC_OCR_KEY=

# graph context format
BCG_RENDER_STYLE=split_confidence  # v0, split, split_confidence
BCG_GRAPH_CHARS=7000
