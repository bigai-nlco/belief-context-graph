# Copy this file to .env. It is the single location for project credentials.

# Primary OpenAI-compatible model API.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_TIMEOUT="60"
OPENAI_MAX_RETRIES="3"

# Optional. Set only when using a non-default OpenAI-compatible endpoint.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Additional chat-model key referenced by bcg/model_config.json.
DEEPSEEK_API_KEY="replace-me"

# Optional Google search for the Agent. The Python runtime reads this value
# directly from the project-root .env when it is not already exported.
SERPER_API_KEY="your-serper-api-key"
SERPER_ENDPOINT="https://google.serper.dev/search"

# Optional embedding API for semantic split/merge.
# Pipeline behavior is configured by Python arguments, not env vars.
# batch_size and dimensions are EmbeddingConfig fields, not env vars.
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY="sk-..."
EMBEDDING_BASE_URL="https://api.openai.com/v1"

# Optional Agent evaluator, retrieval, and dataset credentials.
BROWSECOMP_GRADER_API_KEY=""
JUDGE_API_KEY=""
HERO_EMBEDDING_API_KEY="EMPTY"
HF_TOKEN=""

# Agent rollout settings used by scripts/start.sh. OPENAI_MODEL above is used
# when MODEL is empty. Replace service URLs when they do not run locally.
MODEL=""
AVERITEC_DATA_DIR=""
AVERITEC_DATA_FILE="dev_subset10.json"
BELIEF_GRAPH_URL="http://127.0.0.1:8848"
HERO_EMBEDDING_MODEL="SFR-Embedding-2_R"
HERO_EMBEDDING_URL=""
RERANK_MODEL="Qwen3-Reranker-0.6B"
RERANK_URL="http://127.0.0.1:8010"
JUDGE_MODEL=""
JUDGE_BASE_URL=""

# Optional Vitabench gateway credentials.
VITA_LITELLM_API_KEY=""
VITA_ASSISTANT_API_KEY=""

# TongGraph server and Agent credentials.
TONGGRAPH_TOKEN=""
TONGGRAPH_ADMIN_TOKEN=""
TONGGRAPH_AGENT_WRITER_TOKEN=""
TONGGRAPH_AGENT_READER_TOKEN=""

# Langfuse tracing.
# Tracing is active only when BCG_TRACING_ENABLED is not false and both keys are set.
BCG_TRACING_ENABLED="true"
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."

# Langfuse host. Other data regions include:
# US: https://us.cloud.langfuse.com
# Japan: https://jp.cloud.langfuse.com
# HIPAA: https://hipaa.cloud.langfuse.com
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Dashboard development.
VITE_MEMGRAPH_URI="bolt://127.0.0.1:7687"
VITE_MEMGRAPH_LAB_URL="http://127.0.0.1:3000"
